  },
  {
    "i": 2,
    "start": 9.173,
    "end": 11.987,
    "text": "The leaves are very long ribbons."
  },
  {
    "i": 3,
    "start": 12.307,
    "end": 14.032,
    "text": "Their edges "
  },
  {
    "i": 4,
